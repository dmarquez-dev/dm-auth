{
  "ConnectionStrings":  {
    "DmAuthConnection":  "Server=localhost\\dev;Database=DMAuth;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt":  {
    "Issuer":  "https://localhost:5001",
    "SigningKeyPath":  "./keys/signing-key.json"
  },
  "Cors":  {
    "AllowedOrigins":  [
      "http://localhost:5173"
    ]
  },
  "KeyVault":  {
    "Enabled":  false
  },
  "Serilog":  {
    "MinimumLevel":  {
      "Default":  "Debug",
      "Override":  {
        "Microsoft":  "Information",
        "Microsoft.AspNetCore":  "Warning",
        "Microsoft.EntityFrameworkCore":  "Information",
        "System":  "Information"
      }
    },
    "WriteTo":  [
      {
        "Name":  "Console"
      },
      {
        "Name":  "File",
        "Args":  {
          "path":  "logs/dmauth-.log",
          "rollingInterval":  "Day",
          "retainedFileCountLimit":  7
        }
      }
    ]
  }
}
