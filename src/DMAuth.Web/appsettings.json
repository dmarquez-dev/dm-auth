{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ApplicationInsights": "",
    "DmAuth": "",
    "KeyVault": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "AccessTokenExpiryMinutes": 15,
    "IdTokenExpiryMinutes": 60,
    "RsaPrivateKeyPem": null
  },
  "OAuth": {
    "ClientIdPrefix": "dmauth_"
  },
  "AuthorizationCode": {
    "ExpiryMinutes": 5
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}
